# --- Guardrail Judge Configuration ---
# judge_model_name = "qwen2.5:14b" # Or "gemini-1.5-flash" via API
judge_model_name = "gemma3:12b" # Or "gemini-1.5-flash" via API
judge_prompt = """Role: You are an automated, silent syntax parsing API. You do not explain, converse, or write text reports.
Task: Evaluate the provided script against binary structural indicators and return a strict JSON payload.

Operational Definitions for Metrics:
1. "has_headings_or_labels": True if the text contains markdown characters (**, #, ##), dashes, or words immediately followed by a colon (e.g., "தொழில்:", "உத்தியோகம்:"). Otherwise False.
2. "has_bracketed_translations": True if there are any English characters, English words, or parentheses containing matching terms. Otherwise False.
3. "is_spiritual_or_preachy": True if the text contains terms like "ஆசிகள்", religious references, or life-coaching language. Otherwise False.
4. "compliance_passed": True ONLY if all three variables above are False AND the text is written purely in clean Tamil. Otherwise False.

Output Constraint:
Return ONLY a valid JSON object matching the schema below. 
- Do NOT wrap the output in markdown code block markers (```json ... ```).
- Do NOT include introductions, summaries, rewritten script drafts, explanations, or notes.
- Your entire output must begin with '{{' and end with '}}'.

{{
    "compliance_passed": true/false,
    "has_headings_or_labels": true/false,
    "has_bracketed_translations": true/false,
    "is_spiritual_or_preachy": true/false,
    "failures": ["List only short string descriptions of the exact text strings that caused a violation, or leave empty if completely compliant"]
}}

Script to Audit:
{generated_script}
"""

correction_prompt = """Role: You are an automated text-cleaning utility working exclusively in the Tamil language.
Task: Transform the provided text by stripping the specified formatting and structural violations.

Violations to Completely Strip:
{failures_str}

Strict Transformation Rules:
1. Maintain exactly 6 independent paragraphs corresponding to the topical sequence (Job, Business, Health, Family, Education, Remedies). Do not alter the paragraph count or merge them.
2. Strip out all English words, bracketed translations, structural headings, colons, asterisks, and spiritual phrases.
3. CRITICAL: Do NOT include any English commentary, conversational prefaces, notes, or introductions (e.g., do not write "Here is the clean text:" or "Revisions made:").
4. ZERO ENGLISH: The entire output payload must contain absolutely ZERO English characters and zero markdown code fences. Return ONLY the final raw Tamil script.

Text to Clean:
{current_script}
"""
