# ==============================================================================
# CONFIDENTIAL CONFIGURATION FOR AGENTIC ASTROLOGY PIPELINE
# ==============================================================================

# --- YouTube API Configuration ---
yt_google_api_key = "YOUR_YOUTUBE_API_KEY"
cookie_file_path = "youtube_cookies.txt"

# Search Filters & Fallbacks
yt_query = "(Guru Peyarchi | குரு பெயர்ச்சி) 2026 (Thulam | துலாம்)"
transcript_length = 500
date_time_lookout = 60
language = ['ta']
max_results = 10

# --- Webshare Proxy Configuration (Optional/Legacy) ---
webshare_proxy_user_name = 'NOT USED'
webshare_proxy_password = 'NOT USED'

# --- HeyGen API Configuration ---
heygen_api_key = "YOUR_HEYGEN_API_KEY"

# --- Google Cloud TTS Configuration ---
google_application_credentials = "google-tts-creds.json"

# --- Ollama / Local LLM Settings ---
ollama_url = "http://localhost:11434/api/generate"
model_name = "gemma3:12b"
options = {
    "num_ctx": 16384,
    "temperature": 0.8,  
    "top_p": 0.9,
    "presence_penalty": 0.6 
}

# --- Audio Engine Configurations (FFmpeg & Pydub) ---
ffmpeg_path = r"C:\ffmpeg\bin"
narration_lead_audio = "guru_peyarchi_2026_full.mp3"
background_music_audio = "Raag Hamsadhwani - Sandeep Das, Mayank Raina, Bivakar Chaudhuri.mp3"
final_output_file = "astrology_final_mix.mp3"
bg_music_volume_db = -20

# --- Legacy Fallback Variables (For running standalone scripts) ---
rasi = "Thulam (துலாம்)"
transit = "Guru Peyarchi (குரு பெயர்ச்சி)"
greeting = "இனிய துலாம் ராசி அன்பர்களே!"


#---LLM Engine Prompts---
map_prompt = """Role: You are a silent data extraction API. Do not converse or introduce your response.
Task: Extract specific predictions, practical warnings, and conditional risks for {rasi} during the {transit} from the provided text.

Strict Output Rules:
1. Organize the raw extracted data exclusively under the six index groups below.
2. Do not write introductory text, conclusions, or meta-commentary.
3. If no data exists for a category, leave it blank.

- Job
- Business
- Health
- Family
- Education
- Remedies

Transcript: {transcript}
"""

reduce_prompt = """Role: You are an objective broadcast reader compiling a structured transit report.
Task: Synthesize the provided data into a cohesive broadcast script for {rasi} during the {transit}.

Linguistic and Structural Constraints:
1. Write the ENTIRE script in clear, narrative Tamil.
2. DIRECT ADDRESS START: Begin the response exactly with this phrase and nothing else: "{greeting}"
3. TOPICAL GROUPING: You must structure the script into exactly 6 sequential paragraphs, corresponding to these topics in order: Job, Business, Health, Family, Education, and Remedies.
4. NO LABELS: Each paragraph must start directly with the astrological forecast content. Do NOT include paragraph titles, markdown markers (##, **), or prefix text labels like "உத்தியோகம்:", "தொழில்:", or "Job:".
5. NO SPIRITUALITY: Strictly omit any motivational padding, life-coaching, or phrases like "ஆசிகள்" (blessings).
6. ZERO META-COMMENTARY: Do NOT wrap the output in markdown code blocks (```). Do not include introductions, explanations, notes, or English characters. Output only the raw Tamil script payload.

Summaries to Synthesize:
{combined_summaries}
"""


